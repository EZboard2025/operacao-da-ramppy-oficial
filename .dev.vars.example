# Copia esse arquivo pra .dev.vars e preenche os valores reais.
# .dev.vars é lido automaticamente pelo wrangler em dev.
# NUNCA commita o .dev.vars (já está no .gitignore).

# Ambiente do Next.js (use "development" em local)
NEXTJS_ENV=development

# Segredo HMAC pra assinar cookies de sessão.
# Gera um novo com: openssl rand -hex 32
# IMPORTANTE: use um segredo DIFERENTE do de produção.
AUTH_SECRET="trocar-por-openssl-rand-hex-32"

# ===== Pipedrive (opcional) =====
# Sem PIPEDRIVE_API_TOKEN a integração fica desligada: os contatos captados nos
# eventos continuam salvos aqui, só não sobem pro CRM.
#
# Token: no Pipedrive, foto do perfil (canto superior direito) > Company
# settings > Personal preferences > API. Ou direto: app.pipedrive.com/settings/api
PIPEDRIVE_API_TOKEN=""

# Domínio da sua conta — o pedaço antes de .pipedrive.com na URL que você usa.
# Ex: se você acessa ramppy.pipedrive.com, aqui vai "ramppy".
PIPEDRIVE_DOMINIO=""

# Onde o negócio nasce. Os valores abaixo são os padrões — só preenche se os
# nomes no seu Pipedrive forem outros (precisa bater igualzinho ao que aparece lá).
PIPEDRIVE_FUNIL="Funil Leads"
PIPEDRIVE_ESTAGIO="Contato"
